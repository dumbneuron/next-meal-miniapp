.profile-page{min-height:100vh;background:#F8FAF7;color:#243B31}.profile-header{padding:42rpx 31rpx 74rpx;background:linear-gradient(145deg,#EAF7F4,#F1F8EC);border-radius:0 0 36rpx 36rpx}.profile-header .eyebrow{color:#72A48C;font-size:22rpx}.profile-header .title{font-size:45rpx;margin-top:17rpx}.profile-header .subtitle{font-size:24rpx;color:#829B8B}.profile-body{padding:0 25rpx}.form-card{position:relative;margin-top:-27rpx;padding:29rpx;border-radius:25rpx;background:#fff;border:1rpx solid #EAF0EA;box-shadow:0 8rpx 26rpx rgba(39,82,54,.05)}.form-title{font-size:31rpx;font-weight:800}.form-grid{display:flex;flex-wrap:wrap;gap:13rpx;margin-top:23rpx}.form-cell{width:calc(50% - 7rpx);box-sizing:border-box;background:#F6F9F5;border-radius:17rpx;padding:19rpx}.form-cell>text{display:block;font-size:21rpx;color:#829B87}.picker-value,.input-wrap{margin-top:13rpx;color:#2A5A3F;font-size:27rpx;font-weight:750}.input-wrap{display:flex;align-items:center}.input-wrap input{min-width:0;flex:1;font-size:27rpx;color:#2A5A3F}.input-wrap text{font-size:19rpx;color:#9AAD9F;font-weight:400}.activity-row{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #EEF2ED;margin-top:23rpx;padding-top:23rpx;font-size:23rpx;font-weight:700}.activity-row picker{color:#2B9060}.health-row{display:flex;gap:13rpx;align-items:flex-start;margin-top:25rpx;color:#849888;font-size:21rpx;line-height:1.55}.check-box{flex-shrink:0;width:31rpx;height:31rpx;border:2rpx solid #C7D9CA;border-radius:9rpx;text-align:center;line-height:31rpx;color:#fff}.check-box.checked{background:#36B979;border-color:#36B979}.save-button{background:#34BC7B;border-radius:17rpx;font-size:25rpx;margin-top:27rpx;box-shadow:0 8rpx 20rpx rgba(45,184,112,.17)}.plan-note{background:#EFF8EE;border-radius:21rpx;padding:24rpx;margin-top:17rpx}.plan-note view:first-child{font-size:23rpx;font-weight:800}.plan-note text{display:block;font-size:21rpx;color:#7D9B84;line-height:1.55;margin-top:7rpx}.plan-link{font-size:21rpx;font-weight:800;color:#2C9C65;margin-top:16rpx}.bottom-space{height:70rpx}