.growth-page{min-height:100vh;background:#F8FAF7;color:#20392E}.growth-header{padding:38rpx 30rpx 70rpx;background:linear-gradient(150deg,#ECF7F2,#F3F8EB);border-radius:0 0 34rpx 34rpx}.eyebrow{font-size:21rpx;color:#527B60;letter-spacing:1rpx;font-weight:750}.title{font-size:46rpx;font-weight:800;margin-top:14rpx}.subtitle{font-size:24rpx;color:#597666;line-height:1.5;margin-top:9rpx}.growth-body{padding:0 26rpx}.summary-card{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:27rpx;padding:29rpx;margin-top:-34rpx;position:relative;box-shadow:0 9rpx 30rpx rgba(34,76,49,.07)}.summary-number{font-size:65rpx;font-weight:850;color:#27905B;line-height:1}.summary-number text{font-size:22rpx;margin-left:3rpx}.summary-title{font-size:27rpx;font-weight:800}.summary-card>view:last-child text{display:block;color:#607C68;font-size:21rpx;margin-top:8rpx}.section-title{font-size:31rpx;font-weight:800;margin:37rpx 4rpx 16rpx}.medal-card{display:flex;align-items:center;gap:18rpx;padding:24rpx;background:#fff;border:1rpx solid #E6EEE5;border-radius:22rpx;margin-top:12rpx}.medal-card.unlocked{background:#F1FAF2;border-color:#D2EED8}.medal-icon{width:72rpx;height:72rpx;border-radius:23rpx;display:flex;align-items:center;justify-content:center;background:#EEF3ED;color:#708778;font-size:40rpx;flex-shrink:0}.medal-card.unlocked .medal-icon{background:#D9F1DD;color:#229A59}.medal-copy{flex:1;min-width:0}.medal-name{display:flex;justify-content:space-between;gap:10rpx;font-size:25rpx;font-weight:800}.medal-name text{font-size:19rpx;color:#4B8460;font-weight:650}.medal-desc,.medal-progress{font-size:20rpx;color:#627E6B;margin-top:5rpx}.medal-track{height:9rpx;background:#E9F0E9;border-radius:20rpx;overflow:hidden;margin-top:14rpx}.medal-track view{height:100%;background:#36B775;border-radius:20rpx}.rules-card{background:#EDF5ED;border-radius:20rpx;padding:23rpx;margin-top:19rpx}.rules-card view{font-size:23rpx;font-weight:800}.rules-card text{display:block;margin-top:8rpx;font-size:21rpx;color:#5A7460;line-height:1.6}.week-card{background:#fff;border-radius:22rpx;padding:26rpx}.week-days{display:flex;justify-content:space-between}.week-day{text-align:center;color:#698070;font-size:19rpx}.week-dot{width:52rpx;height:52rpx;border-radius:50%;background:#ECF2EC;color:#52715B;display:flex;align-items:center;justify-content:center;margin-bottom:8rpx}.week-dot.recorded{background:#DFF4E4;color:#218A55}.week-dot.complete{background:#2FA967;color:#fff}.week-copy{font-size:21rpx;color:#5A7360;line-height:1.55;margin-top:22rpx}.actions{text-align:center;margin-top:24rpx}.primary-action{background:#31B776;color:#fff;border-radius:16rpx;font-size:24rpx;font-weight:800}.actions>view{padding:22rpx;color:#307F52;font-size:21rpx}.bottom-space{height:160rpx}.badge-fill-0{width:0}.badge-fill-10{width:10%}.badge-fill-20{width:20%}.badge-fill-30{width:30%}.badge-fill-40{width:40%}.badge-fill-50{width:50%}.badge-fill-60{width:60%}.badge-fill-70{width:70%}.badge-fill-80{width:80%}.badge-fill-90{width:90%}.badge-fill-100{width:100%}
.summary-card>view:last-child text,.medal-desc,.medal-progress,.rules-card text,.week-copy,.actions>view{font-size:23rpx}.medal-name text{font-size:21rpx}.week-day{font-size:22rpx}
.report-card{background:#fff;border:1rpx solid #E4EDE4;border-radius:22rpx;padding:25rpx;margin-top:12rpx}.report-kicker{font-size:21rpx;color:#43805B;font-weight:750}.report-title{font-size:28rpx;font-weight:800;margin-top:9rpx}.report-copy{font-size:23rpx;color:#365344;line-height:1.55;margin-top:13rpx}.report-highlight{font-size:22rpx;color:#356C4A;line-height:1.55;background:#EDF7EE;border-radius:15rpx;padding:17rpx;margin-top:14rpx}
.report-note{font-size:21rpx;color:#5F7968;line-height:1.5;margin:13rpx 4rpx 0}
