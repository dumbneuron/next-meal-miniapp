.trend-page {
  background: #F5F5F0;
  min-height: 100vh;
}

.trend-header {
  background: #E6ECE5;
  border-radius: 0 0 40rpx 40rpx;
  padding: 62rpx 36rpx 89rpx;
  position: relative;
  overflow: hidden;
}

.trend-header .title {
  max-width: 620rpx;
  font-size: 47rpx;
}

.trend-header .subtitle {
  max-width: 580rpx;
  position: relative;
  z-index: 1;
}

.header-orbit {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border: 35rpx solid rgba(160, 196, 172, .25);
  border-radius: 50%;
  right: -170rpx;
  top: 0;
}

.trend-body {
  padding: 0 26rpx;
}

.signal-card {
  background: #1D4032;
  color: #fff;
  border-radius: 29rpx;
  padding: 31rpx;
  margin-top: -36rpx;
  position: relative;
  z-index: 1;
}

.signal-kicker {
  color: #C6E684;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 750;
}

.signal-main {
  font-size: 42rpx;
  font-weight: 760;
  margin-top: 15rpx;
}

.signal-sub {
  color: #B6CFBA;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 9rpx;
}

.signal-stats {
  display: flex;
  margin-top: 27rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .17);
  padding-top: 23rpx;
}

.signal-stats>view {
  width: 50%;
}

.signal-stats>view+view {
  border-left: 1rpx solid rgba(255, 255, 255, .17);
  padding-left: 23rpx;
}

.signal-stats text {
  color: #B3C7B6;
  font-size: 20rpx;
}

.signal-stats view view {
  font-size: 36rpx;
  font-weight: 760;
  margin: 8rpx 0;
}

.signal-stats view view text {
  font-size: 20rpx;
  font-weight: 400;
}

.section-head {
  margin: 53rpx 4rpx 18rpx;
}

.section-head .section-title {
  margin: 7rpx 0 0;
}

.chart-card,
.weigh-card,
.history-card {
  background: #fff;
  border-radius: 26rpx;
  padding: 27rpx;
}

.bars {
  height: 260rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 5rpx;
  border-bottom: 1rpx solid #DDE8DA;
}

.bar-unit {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 65%;
  min-width: 13rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #A8CDA4;
}

.bar-unit:last-child .bar {
  background: #E68362;
}

.bar-unit text {
  color: #A0AA9F;
  font-size: 15rpx;
  height: 26rpx;
  margin-top: 5rpx;
}

.chart-empty {
  color: #859587;
  padding: 65rpx 0;
  text-align: center;
  font-size: 23rpx;
}

.chart-note {
  color: #A0AA9F;
  font-size: 18rpx;
  line-height: 1.5;
  margin-top: 21rpx;
}

.weigh-inputs {
  gap: 13rpx;
}

.date-pill {
  color: #3A5E46;
  background: #EAF2E5;
  border-radius: 18rpx;
  padding: 19rpx;
  font-size: 23rpx;
}

.weight-input {
  flex: 1;
  background: #F5F7F3;
  border-radius: 18rpx;
  padding: 12rpx 17rpx;
  display: flex;
  align-items: center;
}

.weight-input input {
  min-width: 0;
  width: 100%;
  font-size: 25rpx;
}

.weight-input text {
  color: #869588;
  font-size: 19rpx;
}

.weigh-card .button-primary {
  margin-top: 26rpx;
}

.count {
  color: #97A598;
  font-size: 21rpx;
}

.history-card {
  padding: 4rpx 25rpx;
}

.weight-row {
  padding: 21rpx 0;
  border-bottom: 1rpx solid #EDF0EB;
  font-size: 23rpx;
}

.weight-row:last-child {
  border: 0;
}

.weight-row>text {
  color: #819183;
}

.weight-row view {
  font-size: 29rpx;
  font-weight: 740;
}

.weight-row view text {
  font-size: 19rpx;
  font-weight: 400;
}

.trend-foot {
  color: #99A69A;
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
  padding: 34rpx 8rpx 0;
}

.bottom-space {
  height: 175rpx;
}

.trend-page {
  background: #F7F7F2
}

.trend-header {
  background: #EDF3E7;
  padding: 42rpx 36rpx 77rpx;
  border-radius: 0 0 38rpx 38rpx
}

.trend-header .title {
  font-size: 49rpx;
  margin-top: 26rpx
}

.trend-header .subtitle {
  color: #758B7A;
  max-width: 550rpx
}

.header-orbit {
  border: 27rpx solid rgba(187, 215, 168, .23);
  top: 20rpx
}

.signal-card {
  background: #254A3B;
  box-shadow: none;
  border-radius: 26rpx
}

.signal-kicker {
  color: #D7EBAA;
  font-size: 19rpx
}

.signal-main {
  font-size: 38rpx
}

.signal-stats view view {
  font-size: 32rpx
}

.section-head {
  margin-top: 48rpx
}

.chart-card,
.weigh-card,
.history-card {
  border: 1rpx solid #E9EFE6;
  border-radius: 24rpx
}

.bar {
  background: #A7C89A
}

.bar-unit:last-child .bar {
  background: #D59C7D
}

.date-pill {
  background: #EEF4E9;
  border-radius: 14rpx
}

.weight-input {
  background: #F4F6F0;
  border-radius: 14rpx
}

.weigh-card .button-primary {
  background: #2D704C
}

.trend-foot {
  color: #94A597
}

.week-card {
  background: #fff;
  border: 1rpx solid #E9EFE6;
  border-radius: 24rpx;
  padding: 24rpx
}

.week-numbers {
  display: flex;
  border-bottom: 1rpx solid #ECF1E9;
  padding-bottom: 20rpx
}

.week-numbers>view {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #ECF1E9;
  color: #829484;
  font-size: 19rpx
}

.week-numbers>view:last-child {
  border: 0
}

.week-numbers text {
  display: block;
  color: #244D38;
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 4rpx
}

.week-days {
  display: flex;
  justify-content: space-between;
  margin-top: 23rpx
}

.week-day {
  flex: 1;
  text-align: center;
  color: #9AAC9D;
  font-size: 18rpx
}

.week-dot {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #EFF3ED;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx
}

.week-dot.recorded {
  background: #8FBF85
}

.week-dot.complete {
  background: #2E704C
}

.week-message {
  margin-top: 22rpx;
  padding: 17rpx;
  background: #F0F5E8;
  border-radius: 13rpx;
  color: #5E7C62;
  font-size: 21rpx;
  line-height: 1.5
}

.trend-page {
  background: #F8FAF7
}

.trend-header {
  background: linear-gradient(145deg, #EAF7F4, #F0F8EE);
  padding: 39rpx 32rpx 74rpx
}

.trend-header .title {
  font-size: 46rpx
}

.trend-header .subtitle {
  font-size: 24rpx
}

.header-orbit {
  border-color: rgba(94, 191, 137, .12)
}

.signal-card {
  background: #fff;
  color: #233B31;
  border: 1rpx solid #EAF0EA;
  box-shadow: 0 8rpx 24rpx rgba(43, 82, 65, .045)
}

.signal-kicker {
  color: #69A67B;
  font-size: 21rpx
}

.signal-main {
  color: #2F9A64
}

.signal-sub {
  color: #819A88;
  font-size: 24rpx
}

.signal-stats {
  border-top-color: #ECF2EC
}

.signal-stats>view+view {
  border-left-color: #ECF2EC
}

.signal-stats text {
  color: #91A594
}

.signal-stats view view {
  color: #294F38
}

.section-head .eyebrow {
  font-size: 21rpx
}

.section-head .section-title {
  font-size: 32rpx
}

.weigh-card {
  box-shadow: 0 7rpx 23rpx rgba(43, 82, 65, .045)
}

.weigh-card .button-primary {
  background: #35BE7D
}

.week-dot.recorded {
  background: #8DD0A4
}

.week-dot.complete {
  background: #35B476
}

.week-message {
  background: #EDF8EF;
  color: #5D8E6D
}