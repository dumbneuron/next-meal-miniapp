.plan-page { padding: 0 0 0; background: #F5F5F0; }
.plan-header { padding: 60rpx 36rpx 54rpx; background: #DCE9E4; position: relative; overflow: hidden; }
.plan-header::after { content: ''; position: absolute; width: 320rpx; height: 320rpx; border-radius: 50%; right: -100rpx; top: -140rpx; background: rgba(255,255,255,.36); }
.plan-header .title { max-width: 630rpx; position: relative; z-index: 1; }
.plan-header .subtitle { max-width: 610rpx; position: relative; z-index: 1; }
.active-card { margin: -12rpx 26rpx 0; padding: 32rpx; background: #19332C; color: #fff; border-radius: 28rpx; position: relative; z-index: 1; box-shadow: 0 18rpx 40rpx rgba(25,51,44,.15); }
.active-top { color: #B5D3C0; font-size: 23rpx; }
.active-badge { background: #DDF37C; color: #223629; padding: 8rpx 16rpx; border-radius: 100rpx; font-size: 21rpx; font-weight: 700; }
.active-title { font-size: 39rpx; font-weight: 760; margin-top: 30rpx; }
.active-sub { color: #BED0C4; font-size: 23rpx; line-height: 1.5; margin-top: 7rpx; }
.week-row { display: flex; gap: 8rpx; margin-top: 30rpx; overflow: hidden; }
.day-pill { flex: 1; min-width: 0; border-radius: 18rpx; background: #305148; padding: 14rpx 2rpx; display: flex; flex-direction: column; align-items: center; gap: 7rpx; }
.day-pill.high { background: #EC8268; color: #1C2B24; }.day-pill.low { background: #CFDEB3; color: #20392A; }.day-pill.picked { outline: 5rpx solid #FFFFFF; }
.day-week { font-size: 18rpx; opacity: .8; }.day-date { font-size: 25rpx; font-weight: 700; }.day-type { font-size: 23rpx; font-weight: 800; }
.active-footer { color: #B6C8BC; font-size: 21rpx; border-top: 1rpx solid rgba(255,255,255,.17); padding-top: 22rpx; margin-top: 24rpx; }.strong { color: white; font-weight: 750; font-size: 30rpx; }
.section-head { margin: 54rpx 36rpx 20rpx; }.section-head .section-title { margin: 8rpx 0 0; }.section-decor { font-size: 52rpx; color: #E57D60; }
.mode-list { margin: 0 26rpx; display: flex; gap: 12rpx; }
.mode-card { flex: 1; min-width: 0; min-height: 222rpx; border-radius: 24rpx; background: #FFF; padding: 18rpx; box-sizing: border-box; display: flex; flex-direction: column; border: 3rpx solid transparent; }
.mode-card.selected { border-color: #1D493C; background: #F0F6E6; }
.mode-icon { font-size: 43rpx; line-height: 52rpx; color: #E57D60; }.mode-name { font-size: 25rpx; font-weight: 750; margin-top: 12rpx; }.mode-desc { color: #758279; font-size: 20rpx; margin-top: 5rpx; }.mode-check { align-self: flex-end; margin-top: auto; color: #1D493C; font-size: 27rpx; }
.form-panel { margin: 0 26rpx; padding: 26rpx; border-radius: 28rpx; background: #FFFFFF; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.form-cell { background: #F4F6F2; border-radius: 19rpx; padding: 18rpx; }.form-cell.calories { background: #E8F0D0; }.form-cell > text { color: #708177; font-size: 21rpx; }
.input-line { display: flex; align-items: center; gap: 6rpx; }.input-line input { width: 100%; min-width: 0; height: 55rpx; font-size: 32rpx; font-weight: 700; }.input-line text { flex-shrink: 0; color: #8A958D; font-size: 19rpx; }
.mode-fields { border-top: 1rpx solid #ECF0E9; margin-top: 25rpx; padding-top: 25rpx; }.field-heading { font-weight: 750; font-size: 28rpx; }.field-copy { color: #818C82; font-size: 21rpx; line-height: 1.5; margin: 8rpx 0 20rpx; }
.small-chip { display: inline-block; padding: 12rpx 18rpx; background: #EFF2EA; color: #587064; border-radius: 100rpx; font-size: 21rpx; margin-left: 7rpx; margin-bottom: 8rpx; }.small-chip.on { background: #22483B; color: #fff; }.pattern-row { margin: 14rpx 0; }
.mini-input { padding: 14rpx 0; border-bottom: 1rpx solid #EEF0EB; font-size: 23rpx; }.mini-input .input-line { max-width: 280rpx; }.mini-input input { text-align: right; font-size: 26rpx; }
.plan-action { margin-top: 30rpx; background: #D8F174; color: #1C3327; }
.preview-panel { margin: 38rpx 26rpx 0; padding: 32rpx; border-radius: 29rpx; background: #19332C; color: white; }.preview-panel .eyebrow { color: #CDEB85; }.preview-title { font-size: 37rpx; font-weight: 750; margin-top: 12rpx; }.preview-summary { color: #D9E9DB; font-size: 23rpx; margin: 14rpx 0 24rpx; line-height: 1.5; }.preview-summary text { opacity: .75; }
.preview-day { border-top: 1rpx solid rgba(255,255,255,.14); padding: 16rpx 0; }.type-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #E8F2DD; margin-right: 16rpx; }.type-dot.low { background: #B6D98C; }.type-dot.high { background: #F28E72; }.preview-dayname { font-size: 24rpx; font-weight: 700; }.preview-date { font-size: 20rpx; color: #B8C9BC; margin-top: 3rpx; }.preview-numbers { text-align: right; font-size: 26rpx; font-weight: 750; }.preview-numbers text { font-size: 19rpx; }.preview-numbers view + view { font-size: 19rpx; font-weight: 400; color: #B8C9BC; margin-top: 5rpx; }.preview-note { margin-top: 17rpx; color: #B8C9BC; font-size: 21rpx; line-height: 1.55; }.activate { background: #D8F174; color: #1C3327; }
.bottom-space { height: 175rpx; }
.profile-grid { display: flex; flex-wrap: wrap; gap: 13rpx; }.profile-cell { width: calc(50% - 7rpx); box-sizing: border-box; background: #F4F7F2; border-radius: 18rpx; padding: 17rpx; }.profile-cell.weight { background: #E8F1D5; }.profile-cell > text { color: #738475; font-size: 20rpx; }.profile-value,.profile-input { margin-top: 9rpx; height: 49rpx; font-size: 29rpx; font-weight: 740; color: #254634; }.profile-input { display: flex; align-items: center; }.profile-input input { width: 100%; min-width: 0; height: 49rpx; font-size: 29rpx; font-weight: 740; }.profile-input text { flex-shrink: 0; color: #809283; font-size: 20rpx; }
.activity-row { display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid #EDF1E9; padding-top: 22rpx; margin-top: 22rpx; color: #49614E; font-size: 23rpx; }.activity-value { padding: 11rpx 17rpx; background: #EAF2E2; border-radius: 100rpx; color: #2E6442; }
.health-row { display: flex; gap: 12rpx; align-items: flex-start; padding: 21rpx 0 0; }.health-row text { flex: 1; color: #7B8A7D; font-size: 20rpx; line-height: 1.5; }.check-box { width: 29rpx; height: 29rpx; border: 2rpx solid #9DB7A0; border-radius: 9rpx; flex-shrink: 0; color: #fff; text-align: center; line-height: 29rpx; font-size: 21rpx; }.check-box.checked { background: #255A3C; border-color: #255A3C; }.calculate-button { background: #D8F174; color: #21402E; margin-top: 25rpx; }.formula-intro { color: #98A59A; font-size: 19rpx; line-height: 1.5; margin-top: 17rpx; }
.estimate-panel { margin: 30rpx 26rpx 0; padding: 30rpx; background: #fff; border-radius: 29rpx; box-shadow: 0 12rpx 30rpx rgba(27,53,34,.05); }.estimate-title { font-size: 36rpx; font-weight: 800; margin-top: 12rpx; }.estimate-sub { font-size: 22rpx; color: #819084; line-height: 1.5; margin-top: 5rpx; }.estimate-main { display: flex; align-items: baseline; gap: 10rpx; margin: 24rpx 0 17rpx; }.estimate-main > text { font-size: 75rpx; font-weight: 840; letter-spacing: -3rpx; color: #214E36; }.estimate-main view { color: #889889; font-size: 23rpx; }.macro-results { display: flex; gap: 9rpx; }.macro-results > view { flex: 1; border-radius: 15rpx; background: #F0F5EB; padding: 14rpx; }.macro-results > view:nth-child(2) { background: #F8EEE4; }.macro-results text { color: #7D907F; font-size: 19rpx; }.macro-results view view { font-size: 28rpx; font-weight: 760; margin-top: 7rpx; }.estimate-detail { border-top: 1rpx solid #E9EEE8; color: #90A091; font-size: 19rpx; line-height: 1.6; margin-top: 24rpx; padding-top: 18rpx; }
.mode-proposal { background: #EAF2E1; border-radius: 20rpx; padding: 20rpx; margin-top: 24rpx; }.proposal-heading { font-size: 25rpx; font-weight: 740; }.proposal-copy { color: #65836A; font-size: 21rpx; line-height: 1.55; margin-top: 7rpx; }.mode-proposal .pattern-row { margin: 15rpx 0 0; }.mode-proposal .small-chip { margin-left: 0; margin-right: 8rpx; }.advanced-toggle { color: #64866B; font-size: 22rpx; text-align: center; padding: 25rpx 0 8rpx; }.advanced-panel { border-top: 1rpx solid #EBF0E9; margin-top: 13rpx; padding-top: 24rpx; }

