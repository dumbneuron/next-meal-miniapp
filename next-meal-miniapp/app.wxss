page{background:#F7F7F2;color:#17352E;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}.page{box-sizing:border-box;min-height:100vh}.eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#6F9079;font-weight:800}.title{font-size:52rpx;font-weight:800;line-height:1.2;letter-spacing:-1rpx;margin:13rpx 0}.subtitle{color:#788B7C;line-height:1.6;font-size:23rpx}.section-title{font-size:33rpx;font-weight:800;letter-spacing:-1rpx}.row{display:flex;align-items:center;justify-content:space-between}.muted{color:#87988B;font-size:22rpx}.number{font-variant-numeric:tabular-nums}.button-primary{background:#254C3C;color:#fff;border-radius:17rpx;font-size:26rpx;font-weight:750;margin:24rpx 0 0;line-height:2.8}.button-primary::after,.button-secondary::after{border:0}.button-secondary{background:#E6EFDF;color:#315C43;border-radius:17rpx;font-size:24rpx;font-weight:700;margin:20rpx 0 0}.button-link{color:#4C7357;font-size:23rpx;padding:12rpx 0}.field{margin-top:25rpx}.field-label{display:block;color:#627A68;font-size:22rpx;margin-bottom:12rpx}.field-input{background:#F3F6F0;border-radius:15rpx;padding:17rpx 21rpx;height:50rpx;font-size:27rpx}.field-area{background:#F3F6F0;border-radius:15rpx;padding:19rpx;width:100%;box-sizing:border-box;font-size:23rpx;min-height:180rpx}.chip{display:inline-block;padding:12rpx 20rpx;border-radius:100rpx;background:#EAEFE5;color:#526B59;font-size:22rpx;margin:0 12rpx 12rpx 0}.chip-active{background:#2C5A43;color:#fff}.empty{color:#8A9B8C;line-height:1.6;padding:24rpx 0}.divider{height:1rpx;background:#ECF1E9;margin:23rpx 0}
